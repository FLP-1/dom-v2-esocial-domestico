{
  "name": "dom-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:check": "next lint --max-warnings 10",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "tsc --noEmit",
    "build:check": "npm run type-check && npm run lint:check && npm run build",
    "validate": "npm run lint:check && npm run format:check && npm run type-check",
    "validate:fix": "npm run lint:fix && npm run format:fix",
    "validate:strict": "node scripts/validate-rules.js",
    "validate:js": "node scripts/prevent-js-usage.js",
    "validate:syntax": "node scripts/prevent-syntax-errors.js",
    "validate:all": "npm run validate && npm run validate:strict",
    "validate:rigorous": "node scripts/strict-validation.js",
    "validate:naming": "node scripts/validate-file-naming-final.js",
    "fix:emergency": "node scripts/emergency-fix.js",
    "fix:naming": "node scripts/fix-file-naming.js",
    "test": "echo \"Tests not implemented yet\" && exit 0",
    "test:unit": "echo \"Unit tests not implemented yet\" && exit 0",
    "test:integration": "echo \"Integration tests not implemented yet\" && exit 0",
    "test:e2e": "echo \"E2E tests not implemented yet\" && exit 0",
    "test:coverage": "echo \"Coverage tests not implemented yet\" && exit 0"
  },
  "dependencies": {
    "@tippyjs/react": "^4.2.5",
    "next": "^15.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^9.1.3",
    "styled-components": "^5.3.6",
    "swiper": "^11.2.10",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.2",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.4"
  }
}
